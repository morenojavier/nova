# ─────────────────────────────────────────────────────────────
# Variables de entorno — Nova
# ─────────────────────────────────────────────────────────────
# En este momento la app corre en MODO MOCK: no necesita
# credenciales de Supabase para funcionar. Las acciones de auth
# son simuladas (login/signup/logout pasan de inmediato).
#
# Cuando conectes la base de datos real, descomenta las líneas
# de abajo y restaura la lógica real en src/actions/auth.ts.
# ─────────────────────────────────────────────────────────────

# Supabase (opcional por ahora)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (opcional — útil para futuras OAuth redirects)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
